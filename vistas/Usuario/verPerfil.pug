extends ./HomeUsuario

block content
  .row.justify-content-center.mt-4
    .col-md-6.col-lg-5
      .card.shadow.border-0.rounded-4
        .card-body.p-4

          h3.text-center.text-primary.mb-4 Perfil del usuario
          hr

          .mb-3
            strong Usuario:
            span.ms-2.text-secondary #{u.nombre} #{u.apellido}

          .mb-3
            strong E-mail:
            span.ms-2.text-secondary #{u.mail}

          .mb-3
            strong Nick:
            span.ms-2.text-secondary #{u.nick}

          if usuarioValidado.tipoUsuario == 'Validador'
            .mb-3
              strong Dado de baja ? :
              span.ms-2.text-secondary 
              if u.anulado== true
                span.ms-2.text-secondary  SI
              else 
                span.ms-2.text-secondary  NO
            .mb-3
              strong Publicaciones dadas de baja:
              span.ms-2.text-secondary #{publicacionesBajadas}

  .row.justify-content-center.mt-4
    .col-md-5.text-center
      a.btn.btn-outline-primary(href="javascript:history.back()")
        i.fa.fa-arrow-left.me-2
        | Volver
