extends ./HomeUsuario

block content
    .row
      .col-4
      .col-8.p-3
        .card.shadow.p-4(style="width: 400px;")
            h3.text-center Publicación
            h6 Titulo: #{publicacion.titulo.toUpperCase()}
            if publicacion.descripcion!=null
              h6 Descripción: #{publicacion.descripcion}
            h6 Publicada por  #{usuario.nick};
            div.text-center
              if user.id === usuario.id
                if publicacion.denunciada == false 
                  a.mx-2(href="#" onclick=`editarPublicacion(${publicacion.id}, '${publicacion.titulo}', '${publicacion.descripcion}')`)
                  
                    i.fa.fa-pencil(
                      title="EDITAR"
                      style="font-size:25px; color: green;"
                    )
                  a.mx-2(href=`/eliminarPublicacion/${publicacion.id}`)
                    i.fa.fa-trash(
                      title="ELIMINAR"
                      style="font-size:25px; color: green;"
                    )

    .row 
        
        .col-3
        .col-6.bg-dark.p-1.rounded
          #carouselFotos.carousel
            .carousel-inner.p-1
                each imagen, index in imagenes
                  .carousel-item(class=index === 0 ? 'active' : '')
                    
                    a(href=`/imagen/${imagen.id}`)
                      img.d-block.w-100(
                        src=`/${imagen.urlImagen}`
                        alt="Imagen"
                        style="width:300px;  object-fit:cover;"
                      )
                    .mt-2.text-center
                      if user 
                        a.mx-2(href="#" onclick=`Comentar('${imagen.id}')`)
                          i.fa.fa-commenting(title="COMENTAR" style="font-size:25px; color: primary;")
                        if user && user.id !== imagen.idUsuario
                          a.mx-2(href="#" onclick=`Votar('${imagen.id}')`)
                            i.fa.fa-star(title="VOTAR" style="font-size:25px; color: yellow;")  
                          a.mx-2(href="#" onclick=`Denunciar('${imagen.id}')`)
                            i.fa.fa-exclamation-triangle(title="DENUNCIAR" style="font-size:25px; color: red;")
            //- Botones de control del carrusel
            button.carousel-control-prev(
              type="button"
              data-bs-target="#carouselFotos"
              data-bs-slide="prev"
            )
              span.carousel-control-prev-icon
            
            button.carousel-control-next(
              type="button"
              data-bs-target="#carouselFotos"
              data-bs-slide="next"
            )
              span.carousel-control-next-icon
    div.modal(tabindex="-1", id="votar")
            div.modal-dialog
              div.modal-content
                div.modal-header
                  h5.modal-title Votar Imagen
                  button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
                div.modal-body
                  form.row.g-3(action="/votar-imagen", method="post")
                    input(type="hidden", id="idVotada" name="idVotada")
                    .col-md-12
                      h5(class="form-label") Deseas votar: 
                    .col-12
                        label(for ="voto" class="form-label") Vota del 1 al 5 
                        input(type="number" class="form-control" name="voto" required min="1" max="5")
                    .col-12  
                    div.modal-footer
                      button(type="submit" class="btn btn-warning") Votar
                      button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close

    div.modal(tabindex="-1", id="comentar")
          div.modal-dialog
            div.modal-content
              div.modal-header.bg-primary
                h5.modal-title Comentario
                button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
              div.modal-body
                form.row.g-3(action="/comentar-imagen", method="post")
                  input(type="hidden", id="idComentario" name="idComentario")
                  .col-md-12
                    h5(class="form-label") Que deseas comentar? 
                  .col-12
                      textarea(type="text" row= '4' class="form-control" name="comentario" required )
                  .col-12  
                  div.modal-footer
                    button(type="submit" class="btn btn-primary") Enviar comentario
                    button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close 

    div.modal(tabindex="-1", id="editarPublicacion")
          div.modal-dialog
            div.modal-content
              div.modal-header.bg-success
                h5.modal-title.text-center Editar Publicación
                button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
              div.modal-body
                form.row.g-3(action="/editarPublicacion", method="post")
                  input(type="hidden", id="idP" name="idP")
                  .col-md-12
                    h5.text-center(class="form-label") Edita los campos
                  .col-12
                      label(class="form-label") Titulo
                      input(type="text" id = 'Tit' class="form-control" name="t" required )
                  .col-12
                      label(class="form-label") Descripcion
                      input(type="text" id = 'Desc' class="form-control" name="d"  required )
                  .col-12  
                  div.modal-footer
                    button(type="submit" class="btn btn-primary") Editar publicacion
                    button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close 
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js")  
    script.
      function Votar(idVotada) {
      document.querySelector("#idVotada").value = idVotada;
      var myModal = new bootstrap.Modal(document.getElementById('votar'));
      myModal.show();
      }
    script.
      function Comentar(idComentario) {
      document.querySelector("#idComentario").value = idComentario;
      var myModal = new bootstrap.Modal(document.getElementById('comentar'));
      myModal.show();
      }
    script.
      function editarPublicacion(idP, titulo, descripcion) {
      document.querySelector("#idP").value = idP;
      document.querySelector("#Tit").value = titulo;
      document.querySelector("#Desc").value = descripcion;
      var myModal = new bootstrap.Modal(document.getElementById('editarPublicacion'));
      myModal.show();
     }