extends ../Usuario/modoValidador

block content
  .row
    .col-2
    .col-8
      .card.shadow.p-4
        h5.text-center.mb-3 USUARIOS DADOS DE BAJA

        if usuariosAnulados && usuariosAnulados.length > 0
          table.table.table-warning#table
            thead
              tr
                th.text-center ID 
                th.text-center NOMBRE Y APELLIDO
                th.text-center NICK DEL USUARIO
                th.text-center ENLACE
            tbody
              each item in usuariosAnulados
                tr
                  td.text-center #{item.id}
                  td.text-center #{item.nombre.toUpperCase()} #{item.apellido.toUpperCase()} 
                  td.text-center #{item.nick}
                  td.text-center
                    a(href=`/verPerfil/${item.id}`)
                      i.fa.fa-user.p-2(
                        title="VER PERFIL"
                        style="font-size:25px; color:red;")
                    

        else
          p.text-center No se encontraron usuarios anulados.
  .row.justify-content-center.mt-4
    .col-md-5.text-center
      a.btn.btn-outline-primary(href="javascript:history.back()")
        i.fa.fa-arrow-left.me-2
        | Volver